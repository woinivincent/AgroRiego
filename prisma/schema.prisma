// AgroRiego — modelo de datos del MVP
// SQLite no soporta enums en Prisma: los estados se guardan como texto
// usando las constantes de src/lib/constantes.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Parcela {
  id           String   @id @default(cuid())
  nombre       String   @unique
  superficieHa Float
  cultivo      String
  tipoSuelo    String
  metodoRiego  String
  // Caudal del sistema de riego en litros por hora, para estimar el agua aplicada
  caudalLh     Float
  // Cada cuántos días conviene regar esta parcela
  frecuenciaDias Int    @default(3)
  // Etapa fenológica actual: define el Kc con el que se estima la demanda del cultivo
  etapaCultivo String   @default("MEDIA")
  // Profundidad efectiva de raíces (m): junto con la textura del suelo define el agua útil
  profundidadRaizM Float @default(0.8)
  // Fracción del agua útil que se deja agotar antes de volver a regar (p de FAO-56)
  umbralAgotamiento Float @default(0.5)
  // Potencia de la bomba (kW), para estimar el costo de energía de cada riego
  potenciaBombaKw Float?
  // Al completar un riego, agendar automáticamente el siguiente según la frecuencia
  encadenarRiegos Boolean @default(true)
  // Coordenadas del lote: sin ellas no se puede traer el clima de Open-Meteo
  latitud      Float?
  longitud     Float?
  activa       Boolean  @default(true)
  notas        String?
  creadaEn     DateTime @default(now())

  riegos Riego[]
  clima  ClimaDia[]
}

// Parámetros globales de la explotación. Siempre hay una sola fila, con id "default".
model Configuracion {
  id            String   @id @default("default")
  // Evapotranspiración de referencia diaria (mm/día) usada por defecto en la calculadora
  etoDiariaMm   Float    @default(5)
  precioKwh     Float    @default(0)
  precioAguaM3  Float    @default(0)
  actualizadaEn DateTime @updatedAt
}

model Riego {
  id         String   @id @default(cuid())
  parcelaId  String
  parcela    Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  // Momento programado del riego (o momento real si se registra a posteriori)
  fechaHora  DateTime
  duracionMin Int
  estado     String   @default("PROGRAMADO")
  // Litros efectivamente aplicados; sólo se completa al marcar el riego como hecho
  litros     Float?
  notas      String?
  creadoEn   DateTime @default(now())

  @@index([parcelaId])
  @@index([fechaHora])
}

// Clima diario por parcela, cacheado para no depender de la API en cada consulta
// y para poder reconstruir el balance hídrico hacia atrás.
model ClimaDia {
  id         String   @id @default(cuid())
  parcelaId  String
  parcela    Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  // Día al que corresponde el dato, a las 00:00 locales
  fecha      DateTime
  // Evapotranspiración de referencia (mm) y lluvia (mm) de ese día
  etoMm      Float
  lluviaMm   Float    @default(0)
  // OPEN_METEO o MANUAL: un dato cargado a mano nunca se pisa con el de la API
  fuente     String   @default("OPEN_METEO")
  obtenidoEn DateTime @default(now())

  @@unique([parcelaId, fecha])
  @@index([parcelaId])
}
